---
import { SITE } from '../site.config.mjs';
---
<div class="doors">
  <div class="door rv"><span class="k">01 investors</span><h3>Allocate with Gami Capital</h3><p>Access to venture opportunities in onchain finance for qualified investors and institutions.</p><div class="act"><a href={`mailto:${SITE.email}?subject=Investor%20enquiry`}>{SITE.email} <span>→</span></a></div></div>
  <div class="door rv d1"><span class="k">02 founders</span><h3>Raise from Gami Capital</h3><p>Founders rebuilding financial services on blockchain rails. We invest mainly at seed.</p><div class="act"><a href="/contact?role=founder">Send your deck <span>→</span></a></div></div>
  <div class="door l rv d2"><span class="k">03 vaults</span><h3>Gami Labs</h3><p>For curated DeFi vaults and liquidity strategies, visit Gami Labs.</p><div class="act"><a href={SITE.labsUrl} target="_blank" rel="noopener">gamilabs.io <span>↗</span></a></div></div>
</div>
