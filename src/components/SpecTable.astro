---
import { SITE } from '../site.config.mjs';
---
<table class="spec rv">
  <caption class="sr">Gami Capital and Gami Labs compared</caption>
  <thead><tr><th><span class="sr">Attribute</span></th><th scope="col"><span class="hd"><i></i>Gami Capital</span><small>investment firm</small></th><th scope="col" class="l"><span class="hd"><i></i>Gami Labs</span><small>DeFi vault curator</small></th></tr></thead>
  <tbody>
    <tr><th scope="row">role</th><td data-e="capital">Invests in the companies building onchain infrastructure and onchain finance.</td><td class="l" data-e="labs">Curates public and private vaults across a restricted set of vetted DeFi protocols, rebalanced dynamically.</td></tr>
    <tr><th scope="row">assets</th><td data-e="capital"><div class="ch"><span>equity</span><span>tokens</span></div></td><td class="l" data-e="labs"><div class="ch"><span>BTC</span><span>ETH</span><span>USDC</span><span>XRP</span></div></td></tr>
    <tr><th scope="row">for founders</th><td data-e="capital">Investment, mainly at seed, with client introductions and distribution through our network.</td><td class="l" data-e="labs">Liquidity bootstrapping programmes for emerging DeFi protocols, with programmable incentives.</td></tr>
    <tr><th scope="row">clients</th><td data-e="capital">Qualified investors, family offices, HNWI, financial institutions.</td><td class="l" data-e="labs">Institutional allocators, fintech platforms, high-net-worth investors.</td></tr>
    <tr><th scope="row">access</th><td data-e="capital"><a href={`mailto:${SITE.email}`}>{SITE.email}</a></td><td class="l" data-e="labs"><a href={SITE.labsUrl} target="_blank" rel="noopener">gamilabs.io ↗</a></td></tr>
  </tbody>
</table>
