---
import Base from '../layouts/Base.astro';
import Guides from '../components/Guides.astro';
---
<Base title="Page not found | Gami Capital" description="This page does not exist or has moved." noindex>
  <section class="phero nf" data-nav="indigo">
    <div class="wrap">
      <Guides />
      <div>
        <p class="code rv">Error 404</p>
        <h1 class="rv d1">Page not found.</h1>
        <p class="lead rv d2">The page may have moved, or the link may be wrong. You can continue from one of these pages.</p>
        <div class="nf-links co-site on-indigo rv d2">
          <a class="btn btn-w" href="/">Home <span class="ar">→</span></a>
          <a class="btn btn-o" href="/portfolio">Portfolio</a>
          <a class="btn btn-o" href="/insights">Insights</a>
          <a class="btn btn-o" href="/contact">Contact</a>
        </div>
      </div>
    </div>
  </section>
</Base>
