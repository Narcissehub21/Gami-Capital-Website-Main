---
import '@fontsource-variable/archivo/wght.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '../styles/global.css';
import '../styles/pages.css';
import archivoLatin from '@fontsource-variable/archivo/files/archivo-latin-wght-normal.woff2?url';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../site.config.mjs';

interface Crumb { name: string; href: string }
interface Props {
  title: string;               // full <title>
  description: string;
  image?: string;              // absolute path under /public, default OG image
  imageAlt?: string;
  type?: 'website' | 'article' | 'profile';
  published?: Date;
  modified?: Date;
  noindex?: boolean;
  nav?: 'indigo' | 'light' | 'dark';   // nav colour over the first section
  crumbs?: Crumb[];            // breadcrumb trail, excluding Home
  jsonld?: Record<string, unknown>[];
}

const site = Astro.site!;
const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '') || '/';

// Section pages get their own share card (see src/pages/og/page/[page].png.ts).
const seg = path.split('/').filter(Boolean);
const PAGE_OG = ['approach', 'ecosystem', 'portfolio', 'team', 'insights', 'contact'];
const defaultImage = seg.length === 1 && PAGE_OG.includes(seg[0]) ? `/og/page/${seg[0]}.png` : '/og/gami-capital.png';

const {
  title, description, image = defaultImage, imageAlt = title,
  type = 'website', published, modified, noindex = false, nav = 'indigo', crumbs = [], jsonld = [],
} = Astro.props;
const canonical = new URL(path === '/' ? '/' : path.replace(/\/$/, ''), site).href;
const ogImage = new URL(image, site).href;

const graph: Record<string, unknown>[] = [...jsonld];
if (crumbs.length) {
  graph.push({
    '@type': 'BreadcrumbList',
    itemListElement: [{ name: 'Home', href: '/' }, ...crumbs].map((c, i) => ({
      '@type': 'ListItem', position: i + 1, name: c.name, item: new URL(c.href, site).href,
    })),
  });
}
const ld = graph.length ? JSON.stringify({ '@context': 'https://schema.org', '@graph': graph }) : null;
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="canonical" href={canonical}>
{noindex && <meta name="robots" content="noindex, follow">}
<meta name="theme-color" content="#393A8F">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="icon" href="/favicon.ico" sizes="32x32">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link rel="manifest" href="/site.webmanifest">
<link rel="alternate" type="application/rss+xml" title="Gami Capital Insights" href="/rss.xml">
<link rel="preload" href={archivoLatin} as="font" type="font/woff2" crossorigin>

<meta property="og:site_name" content={SITE.name}>
<meta property="og:type" content={type}>
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={canonical}>
<meta property="og:image" content={ogImage}>
<meta property="og:image:alt" content={imageAlt}>
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:locale" content={SITE.locale}>
{published && <meta property="article:published_time" content={published.toISOString()}>}
{modified && <meta property="article:modified_time" content={modified.toISOString()}>}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:site" content={SITE.xHandle}>
<meta name="twitter:title" content={title}>
<meta name="twitter:description" content={description}>
<meta name="twitter:image" content={ogImage}>
{ld && <script type="application/ld+json" set:html={ld} />}
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
<Nav theme={nav} />
<main id="main">
<slot />
</main>
<Footer />
<script>
  import '../scripts/site.ts';
</script>
</body>
</html>
